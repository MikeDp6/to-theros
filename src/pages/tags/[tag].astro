---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getAllPosts, getAllTags, slugifyTag } from "../../lib/posts.js";

export async function getStaticPaths() {
  const tags = await getAllTags();
  const posts = await getAllPosts();

  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.some((t) => slugifyTag(t) === slug)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Base
  title={`#${tag}`}
  description={`Κείμενα του Θέρους με την ετικέτα «${tag}».`}
>
  <section class="listing">
    <div class="container">
      <header class="listing-head">
        <h1>#{tag}</h1>
        <span class="listing-count">
          {posts.length} {posts.length === 1 ? "κείμενο" : "κείμενα"}
        </span>
      </header>

      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</Base>
